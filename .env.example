# ========================================
# Professional Accounting System
# Environment Configuration
# ========================================

# ========================================
# DATABASE (Free Tier Options)
# ========================================

# Option 1: Supabase (Free Tier - 500MB database)
# Get your connection string from: https://supabase.com/dashboard/project/_/settings/database
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Option 2: Neon (Free Tier - 3GB database)
# Get your connection string from: https://neon.tech/dashboard
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST]/[DATABASE]

# Option 3: Local Docker (recommended for go-live today — no URL encoding pain)
# docker compose up -d && pnpm run go-live:local
# DATABASE_URL=postgresql://postgres:boglocal@localhost:5433/accounting

# Option 4: Local Postgres without Docker
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/accounting

# Default (uses localStorage for demo mode when empty)
DATABASE_URL=

# ========================================
# AUTHENTICATION
# ========================================

# JWT Secret for session tokens (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Set to "true" only in trusted local dev to post to GL without a Bearer token (also skips role check)
# SKIP_GL_AUTH=true

# Optional: raise default API rate limit (per IP per 15 min window)
# RATE_LIMIT_MAX=500

# Who may issue customer registration codes (default: PRESIDENT,CFO,CONTROLLER if unset)
# REGISTRATION_ISSUER_ROLES=PRESIDENT,CFO,CONTROLLER
# Stricter per-IP limit for POST /api/registrations/activate (default 40/hour)
# REGISTRATION_ACTIVATE_MAX_PER_HOUR=40

# FX: Frankfurter (ECB) — quote currencies to fetch vs company functional currency (comma-separated ISO codes)
# FX_DEFAULT_QUOTES=USD,EUR,MXN,GBP,CAD
# Max POST /api/exchange-rates/refresh calls per IP per hour (default 30)
# FX_REFRESH_MAX_PER_HOUR=30

# Duplicate-order guard: block same customer/vendor + same lines within N minutes (default 30).
# ORDER_DEDUP_WINDOW_MINUTES=30

# --- Product intelligence (allow-listed feeds; no open web crawling) ---
# Shared secret for POST /api/product-intel/intel/run-cron (GitHub Actions / cron). Header: x-intel-digest-secret
# INTEL_DIGEST_SECRET=
# Optional comma-separated seed feeds when IntelFeedSource table is empty: url|Label,url|Label (HTTPS only)
# INTEL_SEED_FEEDS=https://example.org/news/rss.xml|Example feed
# Summarize digest excerpts with OpenAI (default on when OPENAI_API_KEY set). Set false to store excerpts only.
# INTEL_DIGEST_SUMMARIZE=true
# INTEL_DIGEST_MODEL=gpt-4o-mini
# INTEL_DIGEST_ROW_CAP=4000
# Blocklisted hostnames (comma-separated). Private RFC1918 hostnames are rejected even if not listed.
# INTEL_FEED_HOST_DENYLIST=localhost,127.0.0.1,0.0.0.0,::1,169.254.169.254
# Markdown drafts from POST /api/product-intel/spec-draft
# PRODUCT_SPEC_MODEL=gpt-4o-mini

# --- Agent org (automated accounting program spine) ---
# Shared secret for POST /api/agent-org/run-bookkeeper-cron. Header: x-agent-org-secret
# AGENT_ORG_CRON_SECRET=
# Max RECEIVED events processed per bookkeeper run (default 25)
# AGENT_BOOKKEEPER_BATCH=25
# Future Shopify connector (Connector agent)
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_ACCESS_TOKEN=
# SHOPIFY_WEBHOOK_SECRET=
# SHOPIFY_AUTO_RUN_BOOKKEEPER=true

# ========================================
# AI CPA ASSISTANT
# ========================================

# OpenAI API Key (Free tier: $5 credit for new accounts)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ========================================
# MEXICO CFDI INTEGRATION
# ========================================

# PAC (Proveedor de Certificación de CFDI)
# Options: Solución Factible, SW Developer, FISA, etc.
PAC_API_URL=
PAC_API_KEY=

# Company SAT Certificates
COMPANY_RFC=
COMPANY_CERTIFICATE=
COMPANY_PRIVATE_KEY=

# Environment: 'test' or 'production'
SAT_ENVIRONMENT=test

# ========================================
# US FEDERAL TAX / IRS-ORIENTED FUTURE INTEGRATION
# (No live IRS, SSA, or e-file submission in this app — company flags + env for later use.)
# Real filing uses certified transmitters, separate credentials, and compliance review.
# ========================================

# Example placeholders if you later connect a payroll or 1099 partner (names illustrative only):
# US_PAYROLL_TAX_PROVIDER=
# US_PAYROLL_TAX_CLIENT_ID=
# US_PAYROLL_TAX_CLIENT_SECRET=
# US_1099_TRANSMITTER_ID=
# US_1099_PRODUCTION_PIN=

# ========================================
# BANK CONNECTIVITY (future — not wired in-app yet)
# ========================================
# Company-level toggles live in Settings → Integrations and on the Company record.
# When you add Plaid, Treasury Prime, etc., read credentials here and gate UI with
# useBankFeeds / useBankOutboundPayments from GET /api/company.

# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# ========================================
# APPLICATION SETTINGS
# ========================================

# Server Port
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

# ========================================
# DEMO MODE
# ========================================

# When no database is configured, the app runs in demo mode
# Data is stored in browser localStorage
# Demo mode is active when DATABASE_URL is empty or not set