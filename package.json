{
  "name": "react_repo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "pnpm install --prefer-offline && vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "db:push": "prisma db push",
    "db:bootstrap": "tsx server/scripts/bootstrapBogProgram.ts",
    "go-live:local": "bash scripts/bog-go-live.sh",
    "post:draft-journals": "tsx server/scripts/postAllDraftJournals.ts",
    "seed:autonomy-backlog": "tsx server/scripts/seedAutonomyBacklog.ts",
    "dev:program": "bash scripts/dev-program.sh",
    "seed:investment-sma": "tsx server/scripts/seedInvestmentSmaCompany.ts",
    "issue:tester-invite": "tsx server/scripts/issueTesterInvite.ts",
    "issue:family-preview": "tsx server/scripts/issueTesterInvite.ts",
    "create:family-share-icon": "bash scripts/create-family-preview-launcher.sh",
    "build": "pnpm install --prefer-offline && rm -rf node_modules/.vite-temp && tsc -b && vite build",
    "build:ci": "rm -rf node_modules/.vite-temp && tsc -b && vite build",
    "build:prod": "pnpm install --prefer-offline && rm -rf node_modules/.vite-temp && tsc -b && BUILD_MODE=prod vite build",
    "lint": "pnpm install --prefer-offline && eslint .",
    "preview": "pnpm install --prefer-offline && vite preview",
    "install-deps": "pnpm install --prefer-offline",
    "clean": "rm -rf node_modules .pnpm-store pnpm-lock.yaml && pnpm store prune"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/adapter-pg": "^7.8.0",
