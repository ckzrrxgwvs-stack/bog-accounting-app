    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.364.0",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.4",
    "openai": "^6.35.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "^18.3.1",
